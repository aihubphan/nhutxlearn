# Sao chép thành .env và điền giá trị thật trước khi chạy "npm start".
# Server sẽ KHÔNG khởi động nếu thiếu JWT_SECRET hoặc ADMIN_PASSWORD quá yếu.

API_PORT=4000
DB_FILE=server/data/app.db

# Chuỗi ngẫu nhiên, ít nhất 32 ký tự. Tạo nhanh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tài khoản quản trị được tạo khi server khởi động (mật khẩu >= 10 ký tự).
# Nếu email đã có tài khoản thì chỉ cấp quyền khi mật khẩu trùng khớp.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Đặt 1 khi chạy sau Nginx / Cloudflare / load balancer để giới hạn tần suất lấy đúng IP người dùng
# TRUST_PROXY=1

# Địa chỉ công khai của trang (bắt buộc khi bật VNPay) — VNPay chuyển khách về PUBLIC_URL/api/payments/vnpay/return
PUBLIC_URL=https://ten-mien-cua-ban.vn

# ---- VNPay ----
# Lấy TmnCode và HashSecret trong email VNPay gửi sau khi đăng ký:
#   Sandbox (thử):  https://sandbox.vnpayment.vn/devreg/
#   Production:     ký hợp đồng với VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Mặc định là sandbox. Khi chạy thật, đổi sang URL production VNPay cung cấp.
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
